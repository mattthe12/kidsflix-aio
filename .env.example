# ── Supabase (optional but recommended) ────────────────────────────────────────
# Create a project at https://supabase.com, run supabase/schema.sql, then copy
# Project Settings → API values here. Without these the app runs in local demo
# mode: real accounts, profiles and progress, stored only on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Mux (video) ────────────────────────────────────────────────────────────────
# Demo titles use Mux's public sample playback IDs. For production, upload your
# own licensed videos to Mux and put the default playback ID here.
EXPO_PUBLIC_MUX_PLAYBACK_ID=

# ── Stripe (payments) ──────────────────────────────────────────────────────────
# URL of the deployed stripe-checkout edge function (or a web checkout page).
# Without it the subscription screen explains the required setup instead of
# pretending a payment happened.
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=

# ── Parent email (single Gmail sender, no domain) ─────────────────────────────
# These are server-side Supabase Edge Function secrets, not EXPO_PUBLIC values:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USERNAME=your-account@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx   (Gmail app password)
#   SECURITY_ALERT_FROM="KidsFlix.Aio Security <your-account@gmail.com>"
#   SECURITY_ALERT_REPLY_TO=your-account@gmail.com   (optional)
# The Gmail account must have 2-Step Verification enabled, then create an App
# Password at https://myaccount.google.com/apppasswords. Never commit it or put
# it in an EXPO_PUBLIC_* variable.
# Also set the same Gmail address and app password in Supabase Dashboard →
# Authentication → Emails → SMTP Settings so password-reset mail uses it too.

