# ── Supabase (optional but recommended) ────────────────────────────────────────
# Create a project at https://supabase.com, run supabase/schema.sql, then copy
# Project Settings → API values here. Without these the app runs in local demo
# mode: real accounts, profiles and progress, stored only on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Mux (video) ────────────────────────────────────────────────────────────────
# Demo titles use Mux's public sample playback IDs. For production, upload your
# own licensed videos to Mux and put the default playback ID here.
EXPO_PUBLIC_MUX_PLAYBACK_ID=

# ── Stripe (payments) ──────────────────────────────────────────────────────────
# URL of the deployed stripe-checkout edge function (or a web checkout page).
# Without it the subscription screen explains the required setup instead of
# pretending a payment happened.
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=

# ── Parent PIN security alerts ────────────────────────────────────────────────
# These are server-side Supabase Edge Function secrets, not EXPO_PUBLIC values:
#   RESEND_API_KEY=re_...
#   SECURITY_ALERT_FROM="KidsFlix Security <security@your-verified-domain>"
#   SECURITY_ALERT_REPLY_TO=support@your-domain   (optional)
#   RESEND_WEBHOOK_SECRET=whsec_...               (optional delivery events)
# Never put the Resend key in an EXPO_PUBLIC_* variable or the browser bundle.
# A verified Resend sender domain is required for delivery to parent inboxes.

